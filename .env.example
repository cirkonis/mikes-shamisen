# Copy to `.env` — this file holds ONLY the auth secrets.
#
# The Postgres/Neon vars are NOT here: `vercel env pull .env.local` writes them
# to `.env.local`, and both nuxt.config.ts and drizzle.config.ts load that file.
# Do not redeclare POSTGRES_URL here — `process.loadEnvFile` never overrides an
# already-set variable, so an empty value in `.env` would silently win.

# Secret used to encrypt the session cookie. Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# The single password to log into the app. Choose something strong.
NUXT_APP_PASSWORD=
